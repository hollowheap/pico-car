# Retrieved from https://github.com/netrinomike/barr-c/blob/75bcc16002f8e13ce161743461b9383de9d33388/2018/.clang-tidy
#
# BARR-C:2018 clang-tidy configuration
#
# readability-braces-around-statements     -> 1.3.a braces on every block
# bugprone-assignment-in-if-condition      -> 8.2/8.6 assignment-vs-comparison
# hicpp-signed-bitwise                     -> 5.3.b no bitwise ops on signed
#                                             (alias of bugprone-signed-bitwise after 19)
# bugprone-reserved-identifier             -> 6.1.c/7.1.c leading underscores
# readability-identifier-naming            -> 4.1/5.1/6.1/7.1 naming rules
#                                             (TypedefSuffix _t applies to C typedefs)
# readability-function-size                -> 6.2.a max 100 lines
# cppcoreguidelines-init-variables         -> 7.2.a initialize before use
# bugprone-macro-parentheses               -> 6.3.b.i/ii macro parentheses
# bugprone-macro-repeated-side-effects     -> 6.3.b.iii use parameter once
# readability-magic-numbers                -> 8.4.a no magic loop bounds
# bugprone-switch-missing-default-case     -> 8.3.b default block required (17+)
# readability-isolate-declaration          -> 8.1 one declaration per line
# misc-unused-parameters                   -> 6.2 parameter hygiene
---
Checks: >
  -*,
  readability-braces-around-statements,
  bugprone-assignment-in-if-condition,
  hicpp-signed-bitwise,
  bugprone-reserved-identifier,
  readability-identifier-naming,
  readability-function-size,
  cppcoreguidelines-init-variables,
  bugprone-macro-parentheses,
  bugprone-macro-repeated-side-effects,
  readability-magic-numbers,
  bugprone-switch-missing-default-case,
  readability-isolate-declaration,
  misc-unused-parameters
WarningsAsErrors: '*'
CheckOptions:
  readability-identifier-naming.FunctionCase: lower_case
  readability-identifier-naming.VariableCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  readability-identifier-naming.EnumConstantCase: UPPER_CASE
  readability-identifier-naming.TypedefSuffix: _t
  readability-identifier-naming.GlobalVariablePrefix: g_
  readability-identifier-naming.GlobalPointerPrefix: gp_
  readability-function-size.LineThreshold: 100
  readability-magic-numbers.IgnoredIntegerValues: '0;1'
