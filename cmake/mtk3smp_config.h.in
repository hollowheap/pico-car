#ifndef PICO_CAR_MTK3SMP_CONFIG_H
#define PICO_CAR_MTK3SMP_CONFIG_H

#include "@MTK3SMP_PATH@/config/config.h"

/* The Pico W firmware needs five cyclic handlers. Keep one spare and use
 * the existing Pico Car limits for the remaining kernel object tables. */
#undef CNF_MAX_TSKID
#undef CNF_MAX_SEMID
#undef CNF_MAX_FLGID
#undef CNF_MAX_MBXID
#undef CNF_MAX_MTXID
#undef CNF_MAX_MBFID
#undef CNF_MAX_MPLID
#undef CNF_MAX_MPFID
#undef CNF_MAX_CYCID
#undef CNF_MAX_ALMID

#define CNF_MAX_TSKID 14
#define CNF_MAX_SEMID 8
#define CNF_MAX_FLGID 10
#define CNF_MAX_MBXID 1
#define CNF_MAX_MTXID 2
#define CNF_MAX_MBFID 3
#define CNF_MAX_MPLID 1
#define CNF_MAX_MPFID 1
#define CNF_MAX_CYCID 6
#define CNF_MAX_ALMID 1

#endif
