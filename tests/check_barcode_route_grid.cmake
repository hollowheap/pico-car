# Run each placement in a fresh process since the firmware tasks own static state.
set(failures "")
function(check_invalid_route)
    execute_process(COMMAND "${ROUTE_EXE}" ${ARGV} RESULT_VARIABLE status ERROR_VARIABLE trace)
    if (NOT "${status}" STREQUAL "1")
        string(JOIN " " arguments ${ARGV})
        message(FATAL_ERROR "Expected invalid route arguments to exit 1: ${arguments}, got ${status}\n${trace}")
    endif ()
endfunction()
check_invalid_route(route-striaght-right)
check_invalid_route(route-t-right-typo 0 0)
check_invalid_route(route-left bad 0)
check_invalid_route(route-left 0 bad)
check_invalid_route(route-left -5.5mm 0)
check_invalid_route(route-left 0 10.5mm)
check_invalid_route(route-left nan 0)
check_invalid_route(route-left 0 inf)

foreach (course IN ITEMS route-left route-right route-straight-left route-straight-right
        route-t-left route-t-right route-t-straight-later route-missing-left route-missing-right
        route-single-left route-single-right)
    foreach (lateral IN ITEMS -7 -5.5 -4 -2.5 0 2.5 4 5.5 7)
        foreach (lead IN ITEMS -30 -20 -10 0 10 20 30)
            execute_process(COMMAND "${ROUTE_EXE}" "${course}" "${lateral}" "${lead}"
                RESULT_VARIABLE status ERROR_VARIABLE trace)
            if (NOT "${status}" STREQUAL "0")
                string(APPEND failures "${course}, lateral ${lateral}, fore/aft ${lead}: ${trace}\n")
            endif ()
        endforeach ()
    endforeach ()
endforeach ()
if (failures)
    message(FATAL_ERROR "${failures}")
endif ()
